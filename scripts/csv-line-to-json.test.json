[
  {
    "name": "simple fields",
    "in": "alpha,beta,42",
    "out": "[\n  \"alpha\",\n  \"beta\",\n  42\n]"
  },
  {
    "name": "comma inside quotes",
    "in": "alpha,\"beta, with comma\",42",
    "out": "[\n  \"alpha\",\n  \"beta, with comma\",\n  42\n]"
  },
  {
    "name": "doubled quote",
    "in": "a,\"say \"\"hi\"\"\",b",
    "out": "[\n  \"a\",\n  \"say \\\"hi\\\"\",\n  \"b\"\n]"
  },
  {
    "name": "empty field",
    "in": "a,,b",
    "out": "[\n  \"a\",\n  \"\",\n  \"b\"\n]"
  },
  {
    "name": "types",
    "in": "1,true,false,null,x",
    "out": "[\n  1,\n  true,\n  false,\n  null,\n  \"x\"\n]"
  },
  {
    "name": "single quotes",
    "in": "a,'b,c'",
    "out": "[\n  \"a\",\n  \"b,c\"\n]"
  },
  {
    "name": "trailing empty field",
    "in": "a,b,",
    "out": "[\n  \"a\",\n  \"b\",\n  \"\"\n]"
  },
  {
    "name": "numeric-looking but not a number",
    "in": "12abc",
    "out": "[\n  \"12abc\"\n]"
  },
  {
    "name": "rejects empty input",
    "in": "",
    "error": true
  }
]
