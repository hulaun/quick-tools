[
  {
    "name": "bare get",
    "in": "curl https://x/",
    "out": "{\n  \"method\": \"GET\",\n  \"url\": \"https://x/\",\n  \"headers\": {},\n  \"body\": null\n}"
  },
  {
    "name": "quoted url with query",
    "in": "curl 'https://x/y?a=1&b=2'",
    "out": "{\n  \"method\": \"GET\",\n  \"url\": \"https://x/y?a=1&b=2\",\n  \"headers\": {},\n  \"body\": null\n}"
  },
  {
    "name": "explicit method",
    "in": "curl -X DELETE https://x/1",
    "out": "{\n  \"method\": \"DELETE\",\n  \"url\": \"https://x/1\",\n  \"headers\": {},\n  \"body\": null\n}"
  },
  {
    "name": "headers",
    "in": "curl https://x/ -H 'Accept: application/json' -H 'X-Id: 7'",
    "out": "{\n  \"method\": \"GET\",\n  \"url\": \"https://x/\",\n  \"headers\": {\n    \"Accept\": \"application/json\",\n    \"X-Id\": \"7\"\n  },\n  \"body\": null\n}"
  },
  {
    "name": "header value containing a colon",
    "in": "curl https://x/ -H 'Referer: https://a.b/c'",
    "out": "{\n  \"method\": \"GET\",\n  \"url\": \"https://x/\",\n  \"headers\": {\n    \"Referer\": \"https://a.b/c\"\n  },\n  \"body\": null\n}"
  },
  {
    "name": "data implies post",
    "in": "curl https://x/ --data-raw '{\"a\":1}'",
    "out": "{\n  \"method\": \"POST\",\n  \"url\": \"https://x/\",\n  \"headers\": {},\n  \"body\": \"{\\\"a\\\":1}\"\n}"
  },
  {
    "name": "explicit method wins over implied post",
    "in": "curl -X PUT https://x/ -d 'a=1'",
    "out": "{\n  \"method\": \"PUT\",\n  \"url\": \"https://x/\",\n  \"headers\": {},\n  \"body\": \"a=1\"\n}"
  },
  {
    "name": "line continuations",
    "in": "curl 'https://x/' \\\n  -X POST \\\n  -H 'A: b'",
    "out": "{\n  \"method\": \"POST\",\n  \"url\": \"https://x/\",\n  \"headers\": {\n    \"A\": \"b\"\n  },\n  \"body\": null\n}"
  },
  {
    "name": "unknown flags are ignored",
    "in": "curl --compressed --insecure https://x/",
    "out": "{\n  \"method\": \"GET\",\n  \"url\": \"https://x/\",\n  \"headers\": {},\n  \"body\": null\n}"
  },
  {
    "name": "double quoted arguments",
    "in": "curl \"https://x/\" -H \"Accept: */*\"",
    "out": "{\n  \"method\": \"GET\",\n  \"url\": \"https://x/\",\n  \"headers\": {\n    \"Accept\": \"*/*\"\n  },\n  \"body\": null\n}"
  },
  {
    "name": "rejects input that is not a curl command",
    "in": "wget https://x/",
    "error": true
  }
]
